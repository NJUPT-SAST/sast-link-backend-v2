# ============================================================================
# link.sast.fun —— 替换 /etc/caddy/Caddyfile 中现有的 link.sast.fun 块
#
# 目标机现状（2026-08-08 只读探查确认）：
#   - Caddy 是宿主 systemd 进程，不在容器内，因此上游一律写 127.0.0.1，
#     不能用运行手册里的 api:8080 / frontend:3000 容器名——宿主 Caddy
#     解析不到 Docker 网络内的名字。
#   - 旧 v1 后端  sast-link-backend-sast-link-backend-1  →  0.0.0.0:8081
#   - 旧 v1 前端  sast-link-frontend                     →  127.0.0.1:3000
#   - 新 v2 后端  sast-link-backend-v2                    →  127.0.0.1:8080
#
# 本块只新增 /v2 分流，不触碰 /apis/* 与 handle *，旧版行为完全不变。
# ============================================================================

link.sast.fun {
	encode zstd gzip

	# --- v2 ------------------------------------------------------------------

	# pprof 必须挡在最前面。/debug/pprof 会吐 heap / goroutine dump，还能被用来
	# 驱动 CPU 采样。PPROF_ENABLED 是进程内开关，一次误配就等于公网暴露，所以
	# 在反代层再钉一道，与该变量的取值无关。
	# 需要用时走 SSH 本地转发到 127.0.0.1:8080，不经过这里。
	handle /v2/debug/* {
		respond 404
	}

	# 第三方绑定回调是【前端页面】，后端没有 /oauth/bind/* 这条路由
	# （已核对全量注册清单，确认不存在），落到后端只会拿到 404。
	# 它与登录回调共享 /v2/oauth 父路径，是为了让一个 GitHub OAuth App
	# 的单条 callback URL 同时覆盖登录与绑定两条回调。
	# 详见 docs/runbooks/caddy-reverse-proxy.md。
	handle /v2/oauth/bind/* {
		reverse_proxy 127.0.0.1:3000
	}

	# 其余 /v2/* 是 v2 API。用 handle_path 剥掉 /v2 前缀：后端全部路由都注册在
	# 根路径上（internal/web/router.go 是裸 gin.New()，没有任何 Group），
	# 所以后端收到的必须是 /health、/oauth/token 这样的路径。
	# JWT_ISSUER=https://link.sast.fun/v2 与这里对外呈现的地址必须一致，
	# 否则 OIDC discovery 拼出的 endpoint 与 ID Token 的 iss 都会对不上。
	handle_path /v2/* {
		reverse_proxy 127.0.0.1:8080 {
			# 后端 SetTrustedProxies 需要看到真实客户端 IP：限流与
			# login_failure 计数都按 IP 分桶，拿到的若是 Caddy 自己的地址，
			# 全站会共用一个桶。
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Proto {http.request.scheme}
			header_up Host {upstream_hostport}
		}
	}

	# --- v1（保持原样，勿改）--------------------------------------------------

	handle_path /apis/* {
		rewrite * /api/v1{uri}
		reverse_proxy http://localhost:8081
	}

	handle * {
		reverse_proxy http://localhost:3000
	}
}

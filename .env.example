# App
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=sastlink
DB_PASSWORD=change_me
DB_NAME=sastlink
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DB=0
REDIS_KEY_PREFIX=sastlink

# JWT / OAuth tokens
# JWT_SECRET_KEY is the active RSA private key. JWT_SECRET_KEY_PREV may contain
# the previous RSA private or public key and is used only to verify tokens during rotation.
JWT_SECRET_KEY="-----BEGIN RSA PRIVATE KEY-----\nchange_me\n-----END RSA PRIVATE KEY-----"
JWT_SECRET_KEY_PREV=
JWT_ACTIVE_KID=link-v2-active
JWT_PREVIOUS_KID=
JWT_ISSUER=https://link.sast.fun/v2
JWT_AUDIENCE=sast-link-v2
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_REFRESH_TOKEN_EXPIRY=720h
REFRESH_TOKEN_HMAC_SECRET=replace_with_at_least_32_random_bytes
INTERNAL_OAUTH_CLIENT_ID=sast-link-web

# SMTP (fill credentials in your local .env, never commit secrets)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=false
# Caps simultaneous SMTP sends; each send dials a fresh connection, so a
# verification-code burst beyond this queues instead of exhausting sockets.
SMTP_MAX_CONCURRENT=32

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Trusted reverse proxies (comma-separated CIDRs/IPs trusted to set X-Forwarded-For).
# Default trusts only loopback; set to your load balancer/CDN range in production.
TRUSTED_PROXIES=127.0.0.1,::1

# HSTS max-age in seconds (Strict-Transport-Security). Aligns with PRD default of 1 year.
HSTS_MAX_AGE=31536000

# OAuth Providers (enable as needed)
OAUTH_FEISHU_ENABLED=false
OAUTH_FEISHU_CLIENT_ID=
OAUTH_FEISHU_CLIENT_SECRET=
OAUTH_FEISHU_REDIRECT_URI=http://localhost:3000/oauth/callback/feishu
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:3000/oauth/callback/github

# Object Storage (S3/COS/MinIO)
STORAGE_PROVIDER=cos
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BASE_URL=

# Rate Limiting
RATE_LIMIT_GLOBAL_RPS=100
RATE_LIMIT_LOGIN_RPM=5
RATE_LIMIT_LOGIN_WINDOW=15m
# Both send-email limiters share RATE_LIMIT_SEND_EMAIL_WINDOW: the counts below
# are per window, not per minute. Per target email, then per caller IP.
RATE_LIMIT_SEND_EMAIL_RPM=3
RATE_LIMIT_SEND_EMAIL_IP_RPM=10
RATE_LIMIT_SEND_EMAIL_WINDOW=60s
RATE_LIMIT_CAPTCHA_RPM=5
RATE_LIMIT_REGISTER_RPH=3
LOGIN_FAILURE_LIMIT=10
LOGIN_FAILURE_WINDOW=15m
# Blocks re-unbinding the same third-party address within this window.
UNBIND_COOLDOWN=60s

# Caps simultaneous PBKDF2-SHA512 derivations (600k iterations each). Requests
# beyond this limit queue instead of saturating every CPU core.
PASSWORD_HASH_MAX_CONCURRENT=64

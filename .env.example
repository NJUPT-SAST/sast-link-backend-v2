# App
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=warn
# Exposes /debug/pprof (heap, goroutine and allocation dumps, CPU/trace sampling).
# APP_ENV=development enables it implicitly, so set APP_ENV=production and leave
# this false unless profiling.
PPROF_ENABLED=false

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=sastlink
DB_PASSWORD=change_me
DB_NAME=sastlink
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DB=0
REDIS_KEY_PREFIX=sastlink

# JWT / OAuth tokens
# JWT_SECRET_KEY is the active Ed25519 private key (PKCS#8 PEM). Generate one with:
#   openssl genpkey -algorithm ED25519 -out jwt.key
# and paste the PEM body (with \n for newlines); the placeholder below is NOT a valid
# key and will fail at boot. JWT_SECRET_KEY_PREV holds the previous Ed25519 public
# key, used only to verify tokens during rotation.
JWT_SECRET_KEY="-----BEGIN PRIVATE KEY-----\nchange_me\n-----END PRIVATE KEY-----"
JWT_SECRET_KEY_PREV=
JWT_ACTIVE_KID=link-v2-active
JWT_PREVIOUS_KID=
# Must be an absolute http(s) URL: it is both the iss claim of every token and the
# base the OIDC discovery document builds its endpoint URLs from. A trailing slash is
# stripped at load, so discovery's issuer and the signed iss can never disagree.
JWT_ISSUER=https://link.sast.fun/v2
JWT_AUDIENCE=sast-link-v2
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_REFRESH_TOKEN_EXPIRY=720h
# Caps the total life of a refresh family carrying an admin/user capability scope,
# measured from the family's first authorization; a family reaching it is revoked
# so the client must re-authorize. Plain OIDC families and internal sessions are
# never capped. 0 disables the cap.
JWT_REFRESH_CAPABILITY_MAX_LIFETIME=168h
# Short-TTL per-token auth-state cache replacing the JTI blacklist. A hit skips
# the per-request DB revocation check; revocations write a short-lived tombstone
# and the fill uses SET NX, so a stale entry cannot be re-seeded. Fail-open: on a
# cache error the middleware falls back to oauth_access_tokens.revoked_at.
#
# The TTL bounds state changes that do not revoke (admin edits to "user".state,
# account restore), not the post-revocation window — the tombstone covers that.
AUTH_STATE_CACHE_TTL=15s
REFRESH_TOKEN_HMAC_SECRET=replace_with_at_least_32_random_bytes
INTERNAL_OAUTH_CLIENT_ID=sast-link-web

# OAuth 2.1 / OIDC Provider
# Front-end consent page. GET /oauth/authorize validates the request and
# redirects here with ?request_id=...; the page then calls
# POST /oauth/authorize/consent with the logged-in user's access token.
# Required, no default: a guessed value would redirect users mid-flow to a page
# that does not exist.
OAUTH_CONSENT_URL=http://localhost:3000/oauth/consent
# Authorization code lifetime (PRD §4.10: 5min, single use).
OAUTH_CODE_TTL=5m
# How long a validated authorize request waits in Redis for the consent decision.
OAUTH_AUTHORIZE_REQUEST_TTL=20m

# SMTP (fill credentials in your local .env, never commit secrets)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=false
# Caps simultaneous SMTP sends; each send dials a fresh connection, so a
# verification-code burst beyond this queues instead of exhausting sockets.
SMTP_MAX_CONCURRENT=32

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# httpOnly session cookie — the value a fresh tab uses to bootstrap a session
# (/auth/refresh with an empty body treats this cookie as the refresh credential).
# Path must match the external proxy prefix (Caddy strips /v2). Secure defaults
# on; disable for plain-http local development.
#
# Without a /v2 prefix (e.g. docker-compose serving the API at the root) set
# SESSION_COOKIE_PATH=/ — otherwise the browser never sends the cookie to /auth/*
# and the bootstrap silently no-ops.
SESSION_COOKIE_NAME=sl_session
SESSION_COOKIE_PATH=/v2
SESSION_COOKIE_SECURE=true

# Trusted reverse proxies (comma-separated CIDRs/IPs trusted to set X-Forwarded-For).
# Default trusts only loopback; set to your load balancer/CDN range in production.
TRUSTED_PROXIES=127.0.0.1,::1

# HSTS max-age in seconds (Strict-Transport-Security). Aligns with PRD default of 1 year.
HSTS_MAX_AGE=31536000

# Third-party login providers (SAST Link acting as an OAuth *client*, the opposite
# direction from the OAUTH_* provider settings above). A provider validates only
# when its ENABLED flag is true; a disabled provider's routes stay registered and
# answer 400 rather than 404. Env vars keep the FEISHU spelling while the API's
# enum, routes and identities.provider use "lark".
#
# This backend serves every route at the ROOT path — no /v2 in the Go code — so
# it answers /oauth/github/callback, not /v2/oauth/github/callback; the /v2 in
# JWT_ISSUER is the externally visible base a reverse proxy provides, which OIDC
# discovery concatenates endpoint URLs onto.
#
# The REDIRECT_URI values below must be the EXTERNAL URL a provider can reach,
# including whatever prefix the proxy adds: providers fetch it from the public
# internet and compare the same string again at token exchange (RFC 6749 §4.1.3),
# so a value that only resolves inside the network fails at authorization time.
# Production example, with a proxy stripping /v2 before forwarding:
#   OAUTH_GITHUB_REDIRECT_URI=https://link.sast.fun/v2/oauth/github/callback
OAUTH_FEISHU_ENABLED=false
OAUTH_FEISHU_CLIENT_ID=
OAUTH_FEISHU_CLIENT_SECRET=
# This is the callback URL registered with the Feishu app and where Feishu will
# redirect the browser after authorization. It must point at THIS backend, not the
# frontend: /oauth/lark/callback consumes the provider code and then 302s to one of
# the OAUTH_LOGIN_REDIRECTS allow-listed frontend URLs.
OAUTH_FEISHU_REDIRECT_URI=http://127.0.0.1:8080/oauth/lark/callback
# Required when OAUTH_FEISHU_ENABLED=true. PRD §4.5 limits Lark login to the SAST
# enterprise; an empty value would accept every tenant.
OAUTH_FEISHU_TENANT_KEY=
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Same as above: GitHub redirects here after authorization; the backend callback
# lives at /oauth/github/callback.
#
# 127.0.0.1 rather than localhost, deliberately: GitHub's loopback exception is
# documented for the literal address only, so one http://127.0.0.1/oauth
# registration covers both this backend and the frontend on their own ports.
OAUTH_GITHUB_REDIRECT_URI=http://127.0.0.1:8080/oauth/github/callback

# Comma-separated frontend URLs a provider callback may redirect the browser back
# to. Matched exactly: a prefix rule would turn the callback into an open
# redirector handing out login codes. Required when either provider is enabled;
# only used by this backend, never registered with the provider.
OAUTH_LOGIN_REDIRECTS=http://127.0.0.1:3000/oauth/callback
# Frontend page a failed callback lands on, carrying ?error=&error_description=.
# When empty a failed callback answers with the JSON envelope instead.
OAUTH_LOGIN_ERROR_REDIRECT=http://127.0.0.1:3000/oauth/error
# TTLs for the three fail-closed Redis values this flow owns (PRD §6).
OAUTH_LOGIN_STATE_TTL=10m
OAUTH_LOGIN_REGISTRATION_STATE_TTL=15m
OAUTH_LOGIN_CODE_TTL=60s

# Binding callbacks (frontend routes, consumed by the frontend and the local test
# script — NOT read by this backend). When an already-authenticated user binds a
# third-party identity, the provider code must land on a frontend page that then
# calls POST /user/identities/{lark,github}; register these exact URLs in each
# provider app's redirect allow-list alongside the login callbacks above.
#
# Feishu accepts several redirect URLs per app, so login and bind are separate
# entries. GitHub allows exactly ONE callback URL per app, matched "at or below"
# the registered path — so a single registration covers both callbacks only when
# they share a parent path. Production registers the /v2/oauth prefix:
#
#   Authorization callback URL: https://link.sast.fun/v2/oauth
#   login callback:             https://link.sast.fun/v2/oauth/github/callback
#   bind page (frontend):       https://link.sast.fun/v2/oauth/bind/github
#
# This requires the reverse proxy to route /v2/oauth/bind/* to the frontend while
# every other /v2/* goes to the API (Caddy sorts handle blocks by path
# specificity) — see docs/runbooks/caddy-reverse-proxy.md. Do NOT register the
# bare root https://link.sast.fun: any path under the domain could receive an
# authorization code, and a second OAuth App for binding would not work either —
# Bind() exchanges the code with OAUTH_GITHUB_CLIENT_ID/SECRET, so a code from
# another App is rejected.
#
# Local development uses GitHub's loopback exception instead of a proxy: register
# http://127.0.0.1/oauth (127.0.0.1, not localhost — the exemption is documented
# for the literal address only) and the path rule keeps both callbacks under /oauth.
OAUTH_FEISHU_BIND_REDIRECT_URI=http://127.0.0.1:3000/oauth/bind/lark
OAUTH_GITHUB_BIND_REDIRECT_URI=http://127.0.0.1:3000/oauth/bind/github

# Object Storage (Tencent Cloud COS)
# Backs PUT /user/avatar (PRD §4.9). The group is optional: all empty means
# avatar upload is disabled and the endpoint answers 50002. A partially filled
# set is a startup error.
STORAGE_PROVIDER=cos
# Optional: overrides the bucket access host (bucket name included), e.g. an
# internal or CDN domain. Empty uses {bucket}.cos.{region}.myqcloud.com.
STORAGE_ENDPOINT=
# COS region of the bucket, e.g. ap-nanjing.
STORAGE_REGION=
# Bucket in {name}-{appid} form, e.g. sast-link-1250000000.
STORAGE_BUCKET=
# COS SecretId / SecretKey (must have PutObject/DeleteObject and, when the
# audit is on, the data-cos image review permission).
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Optional: public URL prefix for stored avatars (typically a CDN domain).
# Empty falls back to the bucket access host.
STORAGE_BASE_URL=
# Content review for avatars (CI sensitive-content-recognition). On by default
# and fail-closed: while enabled, an unreachable review service rejects the
# upload. Disable only when the bucket has no data-cos capability.
STORAGE_AUDIT_ENABLED=true
# Avatar upload throttling is per caller.
RATE_LIMIT_UPLOAD_AVATAR_RPM=10
RATE_LIMIT_UPLOAD_AVATAR_WINDOW=60s

# Alumni account requests (POST /alumni-requests): intake for graduated members
# whose school mailbox no longer receives the registration code. Identity
# verification is human: approval is a console action.
#
# Cloudflare Turnstile guards the only unauthenticated write endpoint. The group
# is optional but empty does NOT skip the check: without a secret the endpoint
# answers 50301 and refuses every submission, and clients read that code as
# instruction to hide the entry point.
TURNSTILE_SECRET=
# Must match the action the widget was rendered with, or any token minted under
# the same secret (e.g. harvested from another form) is spendable here.
TURNSTILE_ACTION=alumni_request
# Timeout for one siteverify round trip; an unreachable Cloudflare answers 50301
# rather than admitting the request unverified.
TURNSTILE_TIMEOUT=5s
# Where an approved applicant sets their password — with the PERSONAL email from
# their application, not the school address that became their login identity.
# Required and environment-specific: no code default exists, so an unset value
# fails API startup rather than mailing links at the wrong host.
ALUMNI_RESET_URL=https://link.sast.fun/reset
# Appeal channel quoted in a rejection email.
ALUMNI_SUPPORT_EMAIL=link@sast.fun
# Submission throttling, per IP and per student ID.
RATE_LIMIT_ALUMNI_REQUEST_RPM=5
RATE_LIMIT_ALUMNI_REQUEST_WINDOW=1h

# Rate Limiting
# Every limiter below is per named endpoint and enforced in its service, not by a
# global middleware: a new route inherits no cap and must name one of its own.
#
# Per-IP defaults are loose to fit the campus NAT (hundreds of users share one
# egress IP); the real login defense is the per-account lockout below.
RATE_LIMIT_LOGIN_RPM=500
RATE_LIMIT_LOGIN_WINDOW=15m
# Both send-email limiters share RATE_LIMIT_SEND_EMAIL_WINDOW: the counts below
# are per window, not per minute. Per target email, then per caller IP.
RATE_LIMIT_SEND_EMAIL_RPM=3
RATE_LIMIT_SEND_EMAIL_IP_RPM=100
RATE_LIMIT_SEND_EMAIL_WINDOW=60s
# Throttles POST /auth/register per Register-Ticket, not per IP (each accepted
# call runs one argon2id derivation against a verified email). The window must
# not exceed the ticket's 5-minute TTL — the service refuses to start if it does.
RATE_LIMIT_REGISTER_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW=5m
# Per-account login failure lockout: counter keyed by user ID (by the submitted
# identifier when no such account exists), never by IP. After this many failures
# in the window the account is locked for the rest of it.
LOGIN_FAILURE_LIMIT=10
LOGIN_FAILURE_WINDOW=15m
# Throttles DELETE /user/identities/:id per caller. Keyed by user, not by the
# address being unbound, so one user cannot lock out another who later binds the
# same address.
RATE_LIMIT_UNBIND_RPM=3
RATE_LIMIT_UNBIND_WINDOW=60s
# Throttles DELETE /user/devices/:id per user (the endpoint revokes a whole token
# family).
RATE_LIMIT_DEVICE_RPM=3
RATE_LIMIT_DEVICE_WINDOW=60s
# Throttles GET /oauth/authorize per caller IP (unauthenticated; writes one Redis
# stash key per call).
RATE_LIMIT_AUTHORIZE_RPM=300
RATE_LIMIT_AUTHORIZE_WINDOW=60s
# Throttles GET /oauth/authorize/consent (the consent-info peek) per user, NOT
# per IP: the campus shares one NAT egress IP, and the endpoint is authenticated,
# so the user is a usable key.
RATE_LIMIT_CONSENT_INFO_RPM=60
RATE_LIMIT_CONSENT_INFO_WINDOW=60s
# The consent submission mints an authorization code, so it gets its own per-user
# budget rather than sharing the peek's.
RATE_LIMIT_CONSENT_RPM=60
RATE_LIMIT_CONSENT_WINDOW=60s
# The authorized-apps list and its revoke are per-user budgeted; the revoke runs
# a family-revocation transaction plus a consent-history delete.
RATE_LIMIT_GRANTS_RPM=60
RATE_LIMIT_GRANTS_WINDOW=60s
# Throttles POST /oauth/token and POST /oauth/revoke per caller IP — both check
# client credentials and refresh tokens, so an unlimited rate means unlimited
# credential attempts and DB round trips.
RATE_LIMIT_TOKEN_RPM=300
RATE_LIMIT_TOKEN_WINDOW=60s
# Throttles POST /auth/refresh per caller IP (unauthenticated; each call runs
# several DB statements). Same shape as the token endpoint above.
RATE_LIMIT_REFRESH_RPM=300
RATE_LIMIT_REFRESH_WINDOW=60s
# Throttles GET /oauth/github and GET /oauth/lark per caller IP. Same shape as
# /oauth/authorize — unauthenticated, one oauth_state key written per call — hence the
# same cap.
RATE_LIMIT_OAUTH_LOGIN_RPM=300
RATE_LIMIT_OAUTH_LOGIN_WINDOW=60s
# Throttles POST /oauth/exchange-code per caller IP (unauthenticated; without a
# cap the login_code space can be probed for free).
RATE_LIMIT_EXCHANGE_CODE_RPM=300
RATE_LIMIT_EXCHANGE_CODE_WINDOW=60s

# Caps simultaneous argon2id derivations (also a memory ceiling: 19 MiB each at
# the default parameters). Unset follows GOMAXPROCS; an explicitly empty value is
# treated the same as unset.
ARGON2_CONCURRENCY=

# argon2id is the only KDF for new password hashes. The default m=19456 / t=2 is
# the OWASP low-memory work factor. Raise ARGON2_MEMORY/TIME where offline
# strength matters, within the verify bounds (MEMORY ≤ 65536 KiB, TIME ≤ 10,
# THREADS ≤ 8).
ARGON2_TIME=2
ARGON2_MEMORY=19456
ARGON2_THREADS=1

# --- Data retention ---------------------------------------------------------
# The API sweeps expired rows on a ticker; multiple instances coordinate through a
# PostgreSQL advisory lock so only one sweeps per tick. pg_cron is not used.
RETENTION_INTERVAL=1h
# Rows deleted per statement (keeps a long-neglected sweep from hogging the
# connection pool).
RETENTION_BATCH_SIZE=1000
# Age measured back from now, so a row must have been dead for the whole window;
# the margin absorbs clock skew between the API and PostgreSQL.
RETENTION_AUTHORIZATION_AGE=1h
# Must stay wider than JWT_ACCESS_TOKEN_EXPIRY: an unknown JTI gets the same 401
# as a revoked one, so deleting a row while its JWT is still valid would turn a
# merely expired token into a forced logout. Validation rejects a lower value.
RETENTION_ACCESS_TOKEN_AGE=24h
# Only rotated-away tokens are swept, never a family's first one — that row is
# what dates an ID Token's auth_time.
RETENTION_REFRESH_TOKEN_AGE=24h
# Audit history retention (PRD §9 targets 90 days). May be trimmed as low as 720h
# (30 days); anything below that floor is rejected at startup.
RETENTION_AUDIT_LOG_AGE=2160h
# Reviewed account-request tickets, measured from reviewed_at (default 180 days).
# A PENDING ticket is never swept, however old: the three-day handling target is a
# UI statement, not a rule the backend enforces.
RETENTION_ALUMNI_REQUEST_AGE=4320h
